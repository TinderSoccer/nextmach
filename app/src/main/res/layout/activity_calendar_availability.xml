<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_black"
    tools:context=".booking.CalendarAvailabilityActivity">

    <!-- ScrollView para contenido desplazable -->
    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@id/btn_continue"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Título -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Futbolito Ñuñoa"
                android:textColor="@color/text_white"
                android:textSize="24sp"
                android:textStyle="bold" />

            <!-- Subtitle -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Selecciona fecha y hora disponible"
                android:textColor="@color/text_medium_gray"
                android:textSize="14sp" />

            <!-- Calendario simulado con GridView -->
            <GridView
                android:id="@+id/gv_calendar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:columnWidth="50dp"
                android:horizontalSpacing="8dp"
                android:numColumns="7"
                android:verticalSpacing="8dp" />

            <!-- Título de horarios -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:text="@string/available_times"
                android:textColor="@color/text_white"
                android:textSize="18sp"
                android:textStyle="bold" />

            <!-- Lista de horarios disponibles -->
            <LinearLayout
                android:id="@+id/ll_time_slots"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="vertical">

                <!-- Horario 18:00 -->
                <Button
                    android:id="@+id/btn_time_1800"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginBottom="8dp"
                    android:background="@drawable/bg_button_secondary"
                    android:text="18:00 - 19:00"
                    android:textColor="@color/neon_green"
                    android:textSize="16sp" />

                <!-- Horario 19:00 -->
                <Button
                    android:id="@+id/btn_time_1900"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginBottom="8dp"
                    android:background="@drawable/bg_button_secondary"
                    android:text="19:00 - 20:00"
                    android:textColor="@color/neon_green"
                    android:textSize="16sp" />

                <!-- Horario 20:00 -->
                <Button
                    android:id="@+id/btn_time_2000"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginBottom="8dp"
                    android:background="@drawable/bg_button_secondary"
                    android:text="20:00 - 21:00"
                    android:textColor="@color/neon_green"
                    android:textSize="16sp" />

                <!-- Horario 21:00 -->
                <Button
                    android:id="@+id/btn_time_2100"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:background="@drawable/bg_button_secondary"
                    android:text="21:00 - 22:00"
                    android:textColor="@color/neon_green"
                    android:textSize="16sp" />

            </LinearLayout>

            <!-- Espaciador -->
            <View
                android:layout_width="match_parent"
                android:layout_height="40dp" />

        </LinearLayout>

    </ScrollView>

    <!-- Botón Continuar -->
    <Button
        android:id="@+id/btn_continue"
        android:layout_width="0dp"
        android:layout_height="50dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_button_primary"
        android:text="@string/continue_button"
        android:textColor="@color/text_white"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>